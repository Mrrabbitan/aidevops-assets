{
  "name": "aidevops-assets-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/generated/api.ts",
    "format": "prettier --write src vite.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "echarts": "6.1.0",
    "element-plus": "2.14.5",
    "oidc-client-ts": "3.3.0",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.10.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
